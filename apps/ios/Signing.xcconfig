// SoulNest default signing values for shared/repo builds.
// Personal Apple team and provisioning overrides belong in .local-signing.xcconfig
// or LocalSigning.xcconfig (both are git-ignored).

#include "Config/Version.xcconfig"

OPENCLAW_CODE_SIGN_STYLE = Manual
OPENCLAW_CODE_SIGN_IDENTITY = Apple Development
OPENCLAW_CODE_SIGN_ENTITLEMENTS = Sources/OpenClaw.entitlements
OPENCLAW_DEVELOPMENT_TEAM =

OPENCLAW_APP_BUNDLE_ID = com.wildenstudio.soulnest
OPENCLAW_SHARE_BUNDLE_ID = com.wildenstudio.soulnest.share
OPENCLAW_APP_GROUP_ID = group.com.wildenstudio.soulnest.shared
OPENCLAW_WATCH_APP_BUNDLE_ID = com.wildenstudio.soulnest.watchkitapp
OPENCLAW_ACTIVITY_WIDGET_BUNDLE_ID = com.wildenstudio.soulnest.activitywidget
OPENCLAW_APNS_ENTITLEMENT_ENVIRONMENT = development

OPENCLAW_APP_PROFILE =
OPENCLAW_SHARE_PROFILE =
OPENCLAW_ACTIVITY_WIDGET_PROFILE =
OPENCLAW_WATCH_APP_PROFILE =

// Keep local includes after defaults: xcconfig is evaluated top-to-bottom,
// so later assignments in local files override the defaults above.
#include? ".local-signing.xcconfig"
#include? "LocalSigning.xcconfig"
